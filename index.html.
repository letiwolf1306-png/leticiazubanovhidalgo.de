<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Leticia Zubanovhidalgo</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #171717;
      color: #f5f0e8;
      font-family: Arial, sans-serif;
    }

    h1 {
      padding: 20px;
      text-align: center;
      font-size: clamp(2.5rem, 10vw, 8rem);
      letter-spacing: -0.08em;
      animation: schweben 3s ease-in-out infinite;
    }

    h1 span {
      display: inline-block;
      color: #d5ff63;
      animation: drehen 5s ease-in-out infinite;
    }

    @keyframes schweben {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-18px); }
    }

    @keyframes drehen {
      0%, 100% { transform: rotate(-4deg); }
      50% { transform: rotate(4deg); }
    }
  </style>
</head>

<body>
  <h1>Leticia <span>Zubanovhidalgo</span></h1>
</body>
</html>
