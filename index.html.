<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sternenfänger</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #11152d;
      color: white;
      font-family: Arial, sans-serif;
    }

    main { width: min(92vw, 480px); text-align: center; }
    h1 { margin: 10px; }
    .score { margin: 10px; font-size: 18px; }

    canvas {
      display: block;
      width: 100%;
      border: 2px solid #565b8c;
      border-radius: 14px;
      background: #171d3b;
    }

    button {
      margin: 12px;
      padding: 12px 22px;
      border: 0;
      border-radius: 10px;
      background: #d6fa67;
      color: #171714;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    p { color: #c7c8db; }
  </style>
</head>
<body>
  <main>
    <h1>🌙 Sternenfänger</h1>
    <div class="score">Punkte: <span id="score">0</span></div>
    <canvas id="game" width="480" height="600"></canvas>
    <button id="start">Spiel starten</button>
    <p>Steuerung: ← → oder A / D</p>
  </main>

  <script>
    const canvas = document.getElementById("game");
    const ctx = canvas.getContext("2d");
    const scoreLabel = document.getElementById("score");
    const startButton = document.getElementById("start");

    const player = { x: 240, y: 540, width: 38, height: 34, speed: 6 };
    const keys = {};
    let stars = [];
    let rocks = [];
    let score = 0;
    let playing = false;
    let lastSpawn = 0;
    let animation;

    document.addEventListener("keydown", event => {
      keys[event.key.toLowerCase()] = true;
      if (["arrowleft", "arrowright", " "].includes(event.key.toLowerCase())) {
        event.preventDefault();
      }
    });

    document.addEventListener("keyup", event => {
      keys[event.key.toLowerCase()] = false;
    });

    function startGame() {
      cancelAnimationFrame(animation);
      player.x = 240;
      stars = [];
      rocks = [];
      score = 0;
      scoreLabel.textContent = score;
      lastSpawn = 0;
      playing = true;
      startButton.textContent = "Neu starten";
      animation = requestAnimationFrame(gameLoop);
    }

    function drawBackground() {
      ctx.fillStyle = "#171d3b";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = "#ffffff";
      for (let i = 0; i < 45; i++) {
        const x = (i * 83) % canvas.width;
        const y = (i * 137 + Date.now() / 45) % canvas.height;
        ctx.globalAlpha = 0.3 + (i % 4) * 0.15;
        ctx.fillRect(x, y, 2, 2);
      }
      ctx.globalAlpha = 1;
    }

    function drawPlayer() {
      ctx.fillStyle = "#72d9ff";
      ctx.beginPath();
      ctx.moveTo(player.x, player.y - 20);
      ctx.lineTo(player.x + 20, player.y + 15);
      ctx.lineTo(player.x, player.y + 8);
      ctx.lineTo(player.x - 20, player.y + 15);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = "#ffcf62";
      ctx.fillRect(player.x - 4, player.y + 12, 8, 10);
    }

    function drawStar(star) {
      ctx.fillStyle = "#ffdf72";
      ctx.font = "28px Arial";
      ctx.textAlign = "center";
      ctx.fillText("★", star.x, star.y);
    }

    function drawRock(rock) {
      ctx.fillStyle = "#ff667e";
      ctx.beginPath();
      ctx.arc(rock.x, rock.y, rock.radius, 0, Math.PI * 2);
      ctx.fill();
    }

    function overlaps(item) {
      return Math.abs(item.x - player.x) < item.radius + 17 &&
             Math.abs(item.y - player.y) < item.radius + 15;
    }

    function gameLoop(time) {
      if (!playing) return;

      drawBackground();

      if (keys.arrowleft || keys.a) player.x -= player.speed;
      if (keys.arrowright || keys.d) player.x += player.speed;
      player.x = Math.max(22, Math.min(canvas.width - 22, player.x));

      if (time - lastSpawn > 650) {
        stars.push({
          x: 20 + Math.random() * (canvas.width - 40),
          y: -10,
          radius: 12,
          speed: 2 + Math.random() * 2
        });

        if (Math.random() < 0.7) {
          rocks.push({
            x: 20 + Math.random() * (canvas.width - 40),
            y: -15,
            radius: 13 + Math.random() * 7,
            speed: 2.5 + Math.random() * 2
          });
        }
        lastSpawn = time;
      }

      for (const star of stars) {
        star.y += star.speed;
        drawStar(star);
      }

      for (const rock of rocks) {
        rock.y += rock.speed;
        drawRock(rock);
      }

      stars = stars.filter(star => {
        if (overlaps(star)) {
          score++;
          scoreLabel.textContent = score;
          return false;
        }
        return star.y < canvas.height + 20;
      });

      for (const rock of rocks) {
        if (overlaps(rock)) {
          playing = false;
          ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = "white";
          ctx.textAlign = "center";
          ctx.font = "bold 32px Arial";
          ctx.fillText("Spiel vorbei!", canvas.width / 2, 270);
          ctx.font = "20px Arial";
          ctx.fillText("Punkte: " + score, canvas.width / 2, 310);
          startButton.textContent = "Nochmal spielen";
          return;
        }
      }

      rocks = rocks.filter(rock => rock.y < canvas.height + 30);
      drawPlayer();
      animation = requestAnimationFrame(gameLoop);
    }

    startButton.addEventListener("click", startGame);

    drawBackground();
    drawPlayer();
  </script>
</body>
</html>
